# Copy to .env and adjust. Only DATA_PATH really matters.
#
# DATA_PATH is the host directory holding the entire library: SQLite db,
# managed book/paper files, covers, and the import watch folder. Put it on
# the disk you back up. Defaults to ./data if unset.
DATA_PATH=/mnt/nvme1/library-book/data

TZ=UTC
USER_ID=1000
GROUP_ID=1000

CROSSREF_MAILTO=
GOOGLE_BOOKS_API_KEY=
